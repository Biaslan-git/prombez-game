# База данных
DATABASE_URL=postgres://prombez:prombez@localhost:5432/prombez

# Публичный адрес сайта (canonical, sitemap, schema.org)
NEXT_PUBLIC_SITE_URL=https://prombez-game.ru

# Яндекс Метрика: номер счётчика. Пусто — счётчик не подключается.
NEXT_PUBLIC_YM_ID=

# Реклама РСЯ: включается флагом, блоки без ID не рендерятся.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_RSYA_BLOCK_HOME=
NEXT_PUBLIC_RSYA_BLOCK_AREA=
NEXT_PUBLIC_RSYA_BLOCK_TRAIN=
NEXT_PUBLIC_RSYA_BLOCK_QUESTION=
NEXT_PUBLIC_RSYA_BLOCK_QUESTION_BOTTOM=

# Яндекс Вебмастер: содержимое meta name="yandex-verification"
YANDEX_VERIFICATION=

# Google Search Console: содержимое meta name="google-site-verification"
GOOGLE_SITE_VERIFICATION=

# Почта для «Сообщить об ошибке в вопросе»
NEXT_PUBLIC_FEEDBACK_EMAIL=support@prombez-game.ru

# Секрет для POST /api/revalidate (сброс ISR-кэша после импорта)
REVALIDATE_SECRET=

# Токен для загрузки банков вопросов: POST /api/admin/import (Authorization: Bearer <токен>).
# Пусто — эндпоинт отключён (404). Генерация: openssl rand -hex 32
IMPORT_TOKEN=

# Telegram-бот «Вопрос дня» (Telegram Serverless, см. README). Username бота без @ — включает кнопки подписки на сайте (build-arg).
NEXT_PUBLIC_TELEGRAM_BOT=
# Область, из которой берётся список вопросов для бота (GET /api/telegram/questions); по умолчанию a1
TELEGRAM_AREA=a1
