{
  "name": "prombez-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "import": "tsx scripts/import-questions.ts",
    "import:sample": "tsx scripts/import-questions.ts --area a1 --file data/sample/a1.test.json --version test-2026-10 --publish",
    "postbuild": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "15.5.27",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.5",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
